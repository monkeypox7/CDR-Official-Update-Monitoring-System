{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "additionalDirectories": [
      "../cdrwatch-wt"
    ],
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "WebFetch(domain:www.engineersaustralia.org.au)",
      "WebFetch(domain:immi.homeaffairs.gov.au)",
      "WebFetch(domain:api.prod.legislation.gov.au)",
      "Bash(cd:*)",
      "Bash(ls:*)",
      "Bash(pwd)",
      "Bash(mkdir:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(grep:*)",
      "Bash(wc:*)",
      "Bash(echo:*)",
      "Bash(curl:*)",
      "Bash(py:*)",
      "Bash(python:*)",
      "Bash(.venv/Scripts/python:*)",
      "Bash(.venv/Scripts/ruff:*)",
      "Bash(.venv/Scripts/pytest:*)",
      "Bash(pytest:*)",
      "Bash(ruff:*)",
      "Bash(PYTHONPATH=src:*)",
      "Bash(git:*)",
      "Bash(gh pr:*)",
      "Bash(gh issue:*)",
      "Bash(gh run:*)",
      "Bash(gh workflow:*)",
      "Bash(gh label list:*)",
      "Bash(gh repo view:*)",
      "Bash(gh auth status:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Bash(git push --force:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(gh repo delete:*)",
      "Bash(gh secret:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|Bash",
        "hooks": [
          { "type": "command", "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.py\"", "timeout": 20 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/post_edit.py\"", "timeout": 60 }
        ]
      }
    ]
  }
}
